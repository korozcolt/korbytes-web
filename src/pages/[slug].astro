---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFab from "@/components/WhatsAppFab.astro";
import LeadForm from "@/components/LeadForm.astro";
import { landings, getLanding } from "@/data/landings";
import { EMAIL, SITE, whatsapp } from "@/data/site";

export function getStaticPaths() {
  return landings.map((landing) => ({ params: { slug: landing.slug }, props: { landing } }));
}

const { landing } = Astro.props;
const path = `/${landing.slug}`;
const url = `${SITE}${path}`;
const breadcrumb = [
  { name: "Inicio", url: `${SITE}/` },
  { name: landing.label, url },
];
const related = landing.related.map((s) => getLanding(s)).filter((l) => l !== undefined);
const extraGraph = [
  {
    "@type": "Service",
    "@id": `${url}#service`,
    name: landing.label,
    serviceType: landing.label,
    description: landing.description,
    url,
    provider: { "@id": `${SITE}/#organization` },
    areaServed: { "@type": "Country", name: "Colombia" },
    availableChannel: {
      "@type": "ServiceChannel",
      serviceUrl: whatsapp(landing.waMessage),
    },
  },
];
---

<BaseLayout title={landing.title} description={landing.description} path={path} faqs={landing.faqs} breadcrumb={breadcrumb} extraGraph={extraGraph}>
  <a class="kb-skip" href="#main-content">Saltar al contenido principal</a>

  <header class="lp-header">
    <div class="kb-container lp-header-inner">
      <a href="/" class="lp-brand" aria-label="KOR Bytes inicio">KOR Bytes<span>.</span></a>
      <a class="kb-btn lp-header-cta" href={whatsapp(landing.waMessage)} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
    </div>
  </header>

  <main id="main-content">
    <section class="lp-hero">
      <div class="kb-container lp-hero-grid">
        <div>
          <span class="kb-eyebrow">{landing.eyebrow}</span>
          <h1>{landing.h1}</h1>
          <p class="kb-lead">{landing.lead}</p>
          <div class="lp-actions">
            <a class="kb-btn" href={whatsapp(landing.waMessage)} target="_blank" rel="noopener">Hablar con el fundador</a>
            <a class="lp-secondary" href="#cotizar">Dejar mis datos ↓</a>
          </div>
          <ul class="lp-trust">
            {landing.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <aside class="lp-card" id="cotizar" aria-label="Solicitar diagnóstico">
          <span class="kb-mono lp-card-tag">Diagnóstico gratis</span>
          <h2>Cuéntanos qué necesitas</h2>
          <p>Te respondemos por WhatsApp con una ruta realista y, si aplica, un alcance con precio.</p>
          <LeadForm need={landing.need} source={path} />
        </aside>
      </div>
    </section>

    <section class="kb-section kb-section--soft">
      <div class="kb-container">
        <span class="kb-eyebrow">¿Te suena?</span>
        <h2 class="lp-h2">{landing.problemTitle}</h2>
        <ul class="lp-problems">
          {landing.problems.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>

    <section class="kb-section">
      <div class="kb-container">
        <span class="kb-eyebrow">Lo que entregamos</span>
        <h2 class="lp-h2">{landing.deliverTitle}</h2>
        <div class="lp-cards">
          {landing.deliverables.map((d) => (
            <article><h3>{d.title}</h3><p>{d.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="kb-section kb-section--soft">
      <div class="kb-container">
        <span class="kb-eyebrow">Experiencia real</span>
        <h2 class="lp-h2">Ya lo hemos construido.</h2>
        <div class="lp-cards lp-cards--2">
          {landing.cases.map((c) => (
            <article><h3>{c.name}</h3><p>{c.text}</p></article>
          ))}
        </div>
        <p class="lp-more"><a href="/portafolio">Ver portafolio completo →</a></p>
      </div>
    </section>

    <section class="kb-section">
      <div class="kb-container">
        <span class="kb-eyebrow">Cómo trabajamos</span>
        <div class="lp-steps">
          <article><span>01</span><h3>Conversamos</h3><p>Por WhatsApp o llamada corta: entendemos tu proceso y tu objetivo.</p></article>
          <article><span>02</span><h3>Propuesta</h3><p>Alcance, plazo y precio claros antes de construir nada.</p></article>
          <article><span>03</span><h3>Construimos</h3><p>Entregas por etapas, con avances que puedes probar.</p></article>
          <article><span>04</span><h3>Operamos</h3><p>Desplegamos, monitoreamos y seguimos mejorando contigo.</p></article>
        </div>
      </div>
    </section>

    <section class="kb-section kb-section--soft">
      <div class="kb-container lp-faq-grid">
        <div>
          <span class="kb-eyebrow">Preguntas frecuentes</span>
          <h2>Lo que más nos preguntan.</h2>
        </div>
        <div class="lp-faq-list">
          {landing.faqs.map((faq) => (
            <details class="lp-faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="kb-section">
      <div class="kb-container lp-cta">
        <div>
          <span class="kb-eyebrow">Siguiente paso</span>
          <h2>Escríbenos hoy y te respondemos con una ruta clara.</h2>
          <p>Responde el fundador. Sin compromiso, sin formularios largos.</p>
        </div>
        <div class="lp-cta-actions">
          <a class="kb-btn" href={whatsapp(landing.waMessage)} target="_blank" rel="noopener">Escribir por WhatsApp</a>
          <a class="lp-secondary" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="lp-related" aria-label="Otros servicios">
        <div class="kb-container">
          <span class="kb-mono">También te puede interesar</span>
          <ul>
            {related.map((r) => <li><a href={`/${r.slug}`}>{r.label}</a></li>)}
            <li><a href="/software-a-medida-sincelejo">Software a medida en Sincelejo</a></li>
          </ul>
        </div>
      </section>
    )}
  </main>

  <Footer />
  <WhatsAppFab message={landing.waMessage} />

  <div class="lp-mobile-bar">
    <a class="kb-btn" href={whatsapp(landing.waMessage)} target="_blank" rel="noopener">Escribir por WhatsApp</a>
  </div>
</BaseLayout>

<style>
  .lp-header { position: sticky; top: 0; z-index: 10; background: rgba(5, 9, 15, .88); backdrop-filter: blur(14px); border-bottom: 1px solid var(--kb-line); }
  .lp-header-inner { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .lp-brand { font-family: "Familjen Grotesk", sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--kb-text-strong); }
  .lp-brand span { color: var(--kb-accent); }
  .lp-header-cta { font-size: .82rem; padding: .7rem 1rem; }

  .lp-hero { padding: clamp(56px, 9vw, 120px) 0; }
  .lp-hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .85fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .lp-hero h1 { max-width: 18ch; font-size: clamp(2.1rem, 4.6vw, 3.7rem); line-height: 1.05; }
  .lp-hero-grid > * { min-width: 0; }
  .lp-actions { display: flex; flex-wrap: wrap; gap: 1.2rem; align-items: center; margin-top: 2rem; }
  .lp-secondary { color: var(--kb-text-muted); font-size: .95rem; }
  .lp-secondary:hover { color: var(--kb-accent); }
  .lp-trust { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: .6rem; color: var(--kb-text-muted); font-size: .95rem; }
  .lp-trust li { padding-left: 1.4rem; position: relative; }
  .lp-trust li::before { content: "✓"; position: absolute; left: 0; color: var(--kb-accent); }

  .lp-card { padding: clamp(1.4rem, 3vw, 2rem); border: 1px solid var(--kb-line-strong); border-radius: var(--kb-radius-lg); background: var(--kb-bg-raised); scroll-margin-top: 90px; }
  .lp-card-tag { color: var(--kb-accent); }
  .lp-card h2 { font-size: 1.5rem; margin: .6rem 0 .4rem; }
  .lp-card > p { margin: 0 0 1.4rem; color: var(--kb-text-muted); font-size: .94rem; line-height: 1.55; }

  .lp-h2 { max-width: 24ch; margin: 1rem 0 2rem; }
  .lp-problems { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--kb-line); }
  .lp-problems li { padding: 1.2rem 1.2rem 1.2rem 0; border-bottom: 1px solid var(--kb-line); color: var(--kb-text-muted); line-height: 1.55; }
  .lp-problems li:nth-child(even) { padding-left: 1.2rem; border-left: 1px solid var(--kb-line); }

  .lp-cards { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--kb-line); }
  .lp-cards--2 { grid-template-columns: repeat(2, 1fr); }
  .lp-cards article { padding: 1.6rem 1.3rem 1.4rem 0; border-bottom: 1px solid var(--kb-line); }
  .lp-cards article:not(:nth-child(3n+1)) { padding-left: 1.3rem; border-left: 1px solid var(--kb-line); }
  .lp-cards--2 article:not(:nth-child(3n+1)) { padding-left: 0; border-left: 0; }
  .lp-cards--2 article:nth-child(even) { padding-left: 1.3rem; border-left: 1px solid var(--kb-line); }
  .lp-cards h3 { font-size: 1.15rem; margin: 0 0 .5rem; color: var(--kb-text-strong); }
  .lp-cards p { margin: 0; color: var(--kb-text-muted); line-height: 1.55; font-size: .93rem; }
  .lp-more { margin: 1.5rem 0 0; }
  .lp-more a { color: var(--kb-accent); }

  .lp-steps { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--kb-line); margin-top: 1.5rem; }
  .lp-steps article { padding: 1.7rem 1.3rem 1.2rem 0; border-bottom: 1px solid var(--kb-line); }
  .lp-steps article + article { padding-left: 1.3rem; border-left: 1px solid var(--kb-line); }
  .lp-steps span { color: var(--kb-accent); font-family: "JetBrains Mono", monospace; }
  .lp-steps h3 { font-size: 1.3rem; margin: .8rem 0 .5rem; }
  .lp-steps p { margin: 0; color: var(--kb-text-muted); line-height: 1.55; font-size: .9rem; }

  .lp-faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(2.5rem, 6vw, 4rem); align-items: start; }
  .lp-faq-grid h2 { max-width: 14ch; margin-top: 1rem; }
  .lp-faq-list { border-top: 1px solid var(--kb-line); }
  .lp-faq-item { border-bottom: 1px solid var(--kb-line); }
  .lp-faq-item summary { cursor: pointer; list-style: none; padding: 1.3rem 2.1rem 1.3rem 0; position: relative; font-family: "Familjen Grotesk", sans-serif; font-size: 1.05rem; font-weight: 600; line-height: 1.3; color: var(--kb-text-strong); }
  .lp-faq-item summary::-webkit-details-marker { display: none; }
  .lp-faq-item summary::after { content: "+"; position: absolute; right: 2px; top: 1.1rem; color: var(--kb-accent); font-family: "JetBrains Mono", monospace; font-size: 1.3rem; }
  .lp-faq-item[open] summary::after { content: "−"; }
  .lp-faq-item p { margin: 0; padding: 0 2.1rem 1.3rem 0; color: var(--kb-text-muted); font-size: .94rem; line-height: 1.65; }

  .lp-cta { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: clamp(2rem, 6vw, 4rem); border: 1px solid var(--kb-line); border-radius: var(--kb-radius-lg); background: var(--kb-bg-raised); }
  .lp-cta h2 { max-width: 18ch; }
  .lp-cta p { color: var(--kb-text-muted); margin: .8rem 0 0; }
  .lp-cta-actions { display: grid; gap: 1rem; justify-items: start; }

  .lp-related { padding: 0 0 clamp(80px, 12vw, 140px); }
  .lp-related .kb-mono { color: var(--kb-accent); }
  .lp-related ul { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .lp-related a { display: inline-block; padding: .55rem 1rem; border: 1px solid var(--kb-line-strong); border-radius: var(--kb-radius-full); font-size: .9rem; color: var(--kb-text); }
  .lp-related a:hover { border-color: var(--kb-accent); }

  .lp-mobile-bar { display: none; }

  @media (max-width: 900px) {
    .lp-hero-grid { grid-template-columns: minmax(0, 1fr); }
    .lp-hero h1 { max-width: 20ch; }
    .lp-cards { grid-template-columns: repeat(2, 1fr); }
    .lp-cards article:not(:nth-child(3n+1)) { padding-left: 0; border-left: 0; }
    .lp-cards article:nth-child(even) { padding-left: 1.3rem; border-left: 1px solid var(--kb-line); }
    .lp-steps { grid-template-columns: repeat(2, 1fr); }
    .lp-steps article:nth-child(3) { padding-left: 0; border-left: 0; }
    .lp-cta { flex-direction: column; align-items: start; }
  }
  @media (max-width: 600px) {
    .lp-header-cta { display: none; }
    .lp-problems, .lp-cards, .lp-cards--2, .lp-steps { grid-template-columns: minmax(0, 1fr); }
    .lp-problems li:nth-child(even), .lp-cards article, .lp-cards article:nth-child(even), .lp-steps article + article { padding-left: 0; border-left: 0; }
    .lp-mobile-bar { display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; padding: .7rem 1rem calc(.7rem + env(safe-area-inset-bottom)); background: rgba(5, 9, 15, .94); border-top: 1px solid var(--kb-line-strong); }
    .lp-mobile-bar .kb-btn { width: 100%; justify-content: center; text-align: center; }
    :global(.kb-wa-fab) { bottom: 84px !important; }
  }
</style>
