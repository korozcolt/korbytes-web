---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFab from "@/components/WhatsAppFab.astro";
import { guides } from "@/data/guides";
import { SITE } from "@/data/site";

const path = "/guias";
const breadcrumb = [
  { name: "Inicio", url: `${SITE}/` },
  { name: "Guías", url: `${SITE}${path}` },
];
---

<BaseLayout
  title="Guías de software, web y automatización para empresas | KOR Bytes"
  description="Guías prácticas sobre páginas web, apps, inventario y automatización para empresas en Colombia."
  path={path}
  faqs={[]}
  breadcrumb={breadcrumb}
>
  <header class="gi-header"><div class="kb-container"><a href="/" class="gi-brand">KOR Bytes<span>.</span></a></div></header>
  <main id="main-content" class="kb-container gi-main">
    <span class="kb-eyebrow">Guías</span>
    <h1>Guías para decidir mejor antes de contratar software.</h1>
    <ul class="gi-list">
      {guides.map((g) => (
        <li><a href={`/guias/${g.slug}`}><strong>{g.h1}</strong><span>{g.description}</span></a></li>
      ))}
    </ul>
  </main>
  <Footer />
  <WhatsAppFab message="Hola KOR Bytes, quiero resolver una duda sobre mi proyecto." />
</BaseLayout>

<style>
  .gi-header { border-bottom: 1px solid var(--kb-line); min-height: 72px; display: flex; align-items: center; }
  .gi-brand { font-family: "Familjen Grotesk", sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--kb-text-strong); }
  .gi-brand span { color: var(--kb-accent); }
  .gi-main { padding-block: clamp(48px, 8vw, 110px); }
  .gi-main h1 { max-width: 20ch; font-size: clamp(2rem, 5vw, 3.2rem); margin: 1rem 0 2rem; }
  .gi-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--kb-line); }
  .gi-list a { display: grid; gap: .4rem; padding: 1.5rem 0; border-bottom: 1px solid var(--kb-line); }
  .gi-list strong { font-family: "Familjen Grotesk", sans-serif; font-size: 1.25rem; color: var(--kb-text-strong); }
  .gi-list span { color: var(--kb-text-muted); line-height: 1.55; }
  .gi-list a:hover strong { color: var(--kb-accent); }
</style>
