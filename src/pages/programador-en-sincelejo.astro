---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFab from "@/components/WhatsAppFab.astro";
import { EMAIL, whatsapp } from "@/data/site";

const title = "Programador e ingeniero de sistemas en Sincelejo | KOR Bytes";
const description = "¿Buscas un programador o ingeniero de sistemas en Sincelejo para tu empresa? Contrata un equipo completo de KOR Bytes en vez de un freelance: continuidad, respaldo y entrega real.";

const comparacion = [
  {
    tema: "Si se enferma o renuncia",
    freelance: "Tu proyecto se detiene hasta encontrar reemplazo.",
    equipo: "Otra persona del equipo conoce el código y sigue.",
  },
  {
    tema: "Alcance técnico",
    freelance: "Suele dominar una parte: frontend, backend o infraestructura.",
    equipo: "Backend, frontend, bases de datos, infraestructura y despliegue cubiertos.",
  },
  {
    tema: "Revisión del trabajo",
    freelance: "Nadie más revisa lo que construye.",
    equipo: "Code review interno antes de que algo llegue a producción.",
  },
  {
    tema: "Después de la entrega",
    freelance: "Depende de si sigue disponible o contestando.",
    equipo: "Soporte, monitoreo y evolución del sistema como servicio continuo.",
  },
];

const faqsProgramador: Array<{ question: string; answer: string }> = [
  {
    question: "¿Cuánto cuesta contratar un programador en Sincelejo?",
    answer: "Depende del alcance: un ajuste puntual no cuesta lo mismo que un sistema interno completo. El primer paso siempre es un diagnóstico gratuito por WhatsApp para entender qué necesitas antes de hablar de precio.",
  },
  {
    question: "¿Necesito un ingeniero de sistemas o una empresa de software?",
    answer: "Si el trabajo es puntual y acotado (un script, un ajuste pequeño), un freelance puede bastar. Si el sistema va a sostener una operación real de tu empresa, conviene un equipo con continuidad: alguien que responda si la persona que lo construyó ya no está disponible.",
  },
  {
    question: "¿KOR Bytes contrata ingenieros de sistemas o programadores en Sincelejo?",
    answer: "El equipo se arma según los proyectos en curso. Si eres ingeniero de sistemas o programador en Sincelejo y quieres que tengamos tu perfil en cuenta, escríbenos por WhatsApp o correo con tu experiencia.",
  },
  {
    question: "¿Trabajan con empresas que ya tienen un desarrollador freelance?",
    answer: "Sí. Muchas veces el punto de partida es justamente ese: una empresa con un sistema construido por un freelance que necesita continuidad, documentación o una segunda revisión técnica.",
  },
];
---

<BaseLayout title={title} description={description} path="/programador-en-sincelejo/">
  <a class="kb-skip" href="#main-content">Saltar al contenido principal</a>

  <header class="local-header">
    <div class="kb-container local-header-inner">
      <a href="/" class="local-brand" aria-label="KOR Bytes inicio">KOR Bytes<span>.</span></a>
      <a class="kb-btn local-header-cta" href={whatsapp("Hola KOR Bytes, busco un programador o ingeniero de sistemas para mi proyecto.")} target="_blank" rel="noopener">Hablar por WhatsApp</a>
    </div>
  </header>

  <main id="main-content">
    <section class="local-hero">
      <div class="kb-container local-hero-grid">
        <div>
          <span class="kb-eyebrow">Sincelejo · Sucre · Colombia</span>
          <h1>¿Buscas un programador en Sincelejo? Contrata un equipo, no una sola persona.</h1>
          <p class="kb-lead">KOR Bytes es una casa de software en Sincelejo: cuando contratas, no dependes de un solo ingeniero de sistemas o programador freelance que puede desaparecer a mitad de proyecto.</p>
          <div class="local-actions">
            <a class="kb-btn" href={whatsapp("Hola KOR Bytes, busco un programador o ingeniero de sistemas para mi proyecto.")} target="_blank" rel="noopener">Hablar del proyecto</a>
            <a class="local-email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </div>
        </div>
        <aside class="local-aside" aria-label="Qué cubre el equipo">
          <span class="kb-mono">El equipo cubre</span>
          <ul>
            <li>Backend y frontend</li>
            <li>Bases de datos y arquitectura</li>
            <li>Infraestructura y despliegues</li>
            <li>Soporte después de entregar</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="kb-section">
      <div class="kb-container local-content-grid">
        <div>
          <span class="kb-eyebrow">La diferencia real</span>
          <h2>Un freelance depende de una persona. Un equipo no.</h2>
        </div>
        <div class="local-copy">
          <p>Buscar "programador en Sincelejo" o "ingeniero de sistemas en Sincelejo" casi siempre significa una de dos cosas: necesitas contratar a alguien para tu empresa, o necesitas que alguien construya o mantenga un sistema. Para lo segundo, la pregunta que importa no es "¿qué tan bueno es?" sino "¿qué pasa si un día no puede seguir?".</p>
          <p>Con un freelance, la respuesta casi siempre es: el proyecto se detiene. Con un equipo, otra persona ya conoce el código, la arquitectura y el contexto del negocio, y puede seguir.</p>
        </div>
      </div>
    </section>

    <section class="kb-section kb-section--soft">
      <div class="kb-container">
        <span class="kb-eyebrow">Comparación</span>
        <div class="compare-table" role="table">
          <div class="compare-row compare-head" role="row">
            <span role="columnheader"></span>
            <span role="columnheader">Programador freelance</span>
            <span role="columnheader">Equipo KOR Bytes</span>
          </div>
          {comparacion.map((row) => (
            <div class="compare-row" role="row">
              <span class="compare-tema" role="rowheader">{row.tema}</span>
              <span role="cell">{row.freelance}</span>
              <span role="cell" class="compare-good">{row.equipo}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="kb-section">
      <div class="kb-container local-content-grid">
        <div>
          <span class="kb-eyebrow">Para programadores</span>
          <h2>¿Eres el que busca trabajo, no el que contrata?</h2>
        </div>
        <div class="local-copy">
          <p>Si llegaste aquí buscando empleo como programador o ingeniero de sistemas en Sincelejo: no somos una bolsa de empleo, pero el equipo crece según los proyectos en curso. Escríbenos con tu experiencia si quieres que te tengamos en cuenta.</p>
        </div>
      </div>
    </section>

    <section id="preguntas-programador" class="kb-section kb-section--soft">
      <div class="kb-container local-faq-grid">
        <div>
          <span class="kb-eyebrow">Preguntas frecuentes</span>
          <h2>Antes de escribir, esto puede ayudarte.</h2>
        </div>
        <div class="local-faq-list">
          {faqsProgramador.map((faq) => (
            <details class="local-faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="kb-section">
      <div class="kb-container local-cta">
        <div><span class="kb-eyebrow">Siguiente paso</span><h2>Cuéntanos qué necesitas construir o mantener.</h2></div>
        <a class="kb-btn" href={whatsapp("Hola KOR Bytes, busco un programador o ingeniero de sistemas para mi proyecto.")} target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFab message="Hola KOR Bytes, busco un programador o ingeniero de sistemas para mi proyecto." />
</BaseLayout>

<style>
  .local-header { position: sticky; top: 0; z-index: 10; background: rgba(5, 9, 15, .88); backdrop-filter: blur(14px); border-bottom: 1px solid var(--kb-line); }
  .local-header-inner { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .local-brand { font-family: "Familjen Grotesk", sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--kb-text-strong); }.local-brand span { color: var(--kb-accent); }
  .local-header-cta { font-size: .82rem; padding: .7rem 1rem; }
  .local-hero { padding: clamp(100px, 14vw, 180px) 0; }.local-hero-grid, .local-content-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, .75fr); gap: clamp(2.5rem, 8vw, 7rem); align-items: end; }
  .local-hero h1 { max-width: 18ch; }.local-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 2rem; }.local-email { color: var(--kb-text-muted); font-size: .94rem; }
  .local-aside { padding: 1.8rem; border: 1px solid var(--kb-line); border-radius: var(--kb-radius-lg); background: var(--kb-bg-raised); }.local-aside > span { color: var(--kb-accent); }.local-aside ul { margin: 1.2rem 0 0; padding: 0; list-style: none; display: grid; gap: .8rem; color: var(--kb-text-muted); line-height: 1.5; }
  .local-content-grid { align-items: start; }.local-content-grid h2 { max-width: 20ch; }.local-copy { color: var(--kb-text-muted); line-height: 1.72; font-size: 1.05rem; }.local-copy p:first-child { margin-top: 0; }

  .compare-table { display: grid; border-top: 1px solid var(--kb-line); }
  .compare-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.2rem; padding: 1.1rem 0; border-bottom: 1px solid var(--kb-line); }
  .compare-head span { font-family: "JetBrains Mono", monospace; font-size: .76rem; letter-spacing: .06em; text-transform: uppercase; color: var(--kb-text-soft); }
  .compare-tema { font-weight: 600; color: var(--kb-text-strong); }
  .compare-row span:not(.compare-tema) { color: var(--kb-text-muted); font-size: .94rem; line-height: 1.5; }
  .compare-good { color: var(--kb-text); }

  .local-faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(2.5rem, 6vw, 4rem); align-items: start; }
  .local-faq-grid h2 { max-width: 16ch; margin-top: 1rem; }
  .local-faq-list { border-top: 1px solid var(--kb-line); }
  .local-faq-item { border-bottom: 1px solid var(--kb-line); }
  .local-faq-item summary { cursor: pointer; list-style: none; padding: 1.35rem 2.1rem 1.35rem 0; position: relative; font-family: "Familjen Grotesk", sans-serif; font-size: 1.05rem; font-weight: 600; line-height: 1.3; color: var(--kb-text-strong); }
  .local-faq-item summary::-webkit-details-marker { display: none; }
  .local-faq-item summary::after { content: "+"; position: absolute; right: 2px; top: 1.15rem; color: var(--kb-accent); font-family: "JetBrains Mono", monospace; font-size: 1.3rem; }
  .local-faq-item[open] summary::after { content: "−"; }
  .local-faq-item p { margin: 0; padding: 0 2.1rem 1.35rem 0; color: var(--kb-text-muted); font-size: .94rem; line-height: 1.65; }

  .local-cta { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: clamp(2rem, 6vw, 4rem); border: 1px solid var(--kb-line); border-radius: var(--kb-radius-lg); background: var(--kb-bg-raised); }.local-cta h2 { max-width: 16ch; }

  @media (max-width: 850px) {
    .local-hero-grid, .local-content-grid, .local-faq-grid { grid-template-columns: 1fr; }
    .compare-row { grid-template-columns: 1fr; gap: .3rem; padding: 1.3rem 0; }
    .compare-head { display: none; }
    .compare-tema { margin-bottom: .2rem; }
    .local-cta { align-items: start; flex-direction: column; }
  }
  @media (max-width: 520px) { .local-header-cta { display: none; } }
</style>
