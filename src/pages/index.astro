---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFab from "@/components/WhatsAppFab.astro";
import Journey from "@/components/Journey.astro";
import { landings } from "@/data/landings";
import {
  navAnchors,
  services,
  passProducts,
  projects,
  clientSites,
  practica,
  pasos,
  hechos,
  faqs,
  whatsapp,
  EMAIL,
  GITHUB_URL,
  GITHUB_FOUNDER_URL,
  INSTAGRAM_URL,
  LINKEDIN_URL,
  FOUNDER_NAME,
  FOUNDER_TITLE,
} from "@/data/site";

const stack = [
  "Laravel", "Filament", "Livewire", "PASS Core", "n8n", "Dokploy",
  "VPS", "Redis", "Postgres", "Shopify", "MercadoPago", "Wompi",
  "Bagisto", "Docker", "GitHub Actions",
];

// Cada servicio enlaza a su landing dedicada (índice = orden en `services`).
const serviceLinks = [
  "/desarrollo-de-software-colombia",
  "#pass",
  "/integracion-whatsapp-business",
  "/landing-pages-colombia",
  "/automatizacion-de-procesos",
  "#contacto",
];

function initials(name: string) {
  return name.split(/[\s/+-]+/).map((w) => w[0]).join("").slice(0, 3).toUpperCase();
}
---

<BaseLayout>
  <a class="kb-skip" href="#main-content">Saltar al contenido principal</a>

  <div id="preloader" class="kb-preloader" aria-hidden="true">
    <div class="kb-preloader-top">
      <span class="kb-mark">K</span>
      <span class="kb-wordmark">KOR Bytes<span class="kb-dot">.</span></span>
    </div>
    <div class="kb-preloader-mid">
      <span class="kb-preloader-label">Software operativo</span>
      <span class="kb-preloader-num"><span id="preloader-num">0</span><span class="kb-dot">%</span></span>
    </div>
    <div class="kb-preloader-bar"><div id="preloader-fill" class="kb-preloader-fill"></div></div>
  </div>

  <header class="kb-header" id="site-header">
    <div class="kb-container kb-header-inner">
      <a href="#top" id="logo-slot" class="kb-logo-slot" aria-label="KOR Bytes">
        <span class="kb-mark">K</span>
        <span class="kb-logo-slide-wrap">
          <span class="kb-logo-slide">
            <span class="kb-wordmark">KOR Bytes<span class="kb-dot">.</span></span>
            <span class="kb-wordmark kb-wordmark--accent">KOR Bytes<span class="kb-dot kb-dot--inverse">.</span></span>
          </span>
        </span>
      </a>

      <nav class="kb-hnav" aria-label="Navegación principal">
        {navAnchors.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <a class="kb-hnav-cta" href={whatsapp("Hola KOR Bytes, quiero una consultoría para mi proyecto digital.")} target="_blank" rel="noopener">
        <span class="kb-hnav-dot" aria-hidden="true"></span>Hablemos por WhatsApp
      </a>

      <button class="kb-menu-btn" type="button" id="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div class="kb-mobile-menu" id="mobile-menu">
      {navAnchors.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={whatsapp("Hola KOR Bytes, quiero una consultoría para mi proyecto digital.")} target="_blank" rel="noopener">
        Hablar por WhatsApp
      </a>
    </div>
  </header>

  <main id="main-content">
    <Journey />

    <div class="after-journey">
    <section class="kb-section kb-manifesto" aria-label="Qué hacemos">
      <div class="kb-container">
        <span class="kb-eyebrow kb-eyebrow--dot">KOR Bytes como empresa madre</span>
        <p class="kb-manifesto-text" data-words>No hacemos software. Ordenamos operaciones. PASS convierte patrones repetidos en verticales con módulos reutilizables, y cada proyecto a medida parte de ese mismo núcleo.</p>
        <div class="kb-manifesto-foot">
          <ol class="kb-practica-list">
            {practica.map((row) => (
              <li class="kb-practica-row">
                <span class="kb-accent-text kb-mono">{row.n}</span>
                <span>{row.text}</span>
              </li>
            ))}
          </ol>
          <a href="#pass" class="kb-btn">Explorar ecosistema PASS →</a>
        </div>
      </div>
    </section>

    <div class="kb-marquee">
      <div class="kb-marquee-track" data-marquee-track>
        <div class="kb-marquee-group">
          <span>Software operativo</span><span class="kb-accent-text">✳</span>
          <span class="kb-text-soft">hablemos</span><span class="kb-accent-text">✳</span>
          <span>Productos verticales PASS</span><span class="kb-accent-text">✳</span>
          <span class="kb-text-soft">hablemos</span><span class="kb-accent-text">✳</span>
          <span>Integraciones y automatización</span><span class="kb-accent-text">✳</span>
          <span class="kb-text-soft">hablemos</span><span class="kb-accent-text">✳</span>
        </div>
      </div>
    </div>

    <section id="servicios" class="kb-section">
      <div class="kb-container">
        <div class="kb-section-head">
          <div>
            <h2>Capacidades comerciales</h2>
          </div>
          <p class="kb-body">Desde la web pública hasta el sistema que opera por dentro.</p>
        </div>
        <div class="kb-grid kb-grid-3 kb-svc-grid" data-reveal-stagger>
          {services.map((s, index) => (
            <a href={serviceLinks[index] ?? "#contacto"} class="kb-svc-card">
              <span class="kb-svc-top"><span class="kb-svc-n kb-mono">{String(index + 1).padStart(2, "0")}</span><span class="kb-mono kb-accent-text">{s.tag}</span></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="kb-chips">{s.chips.map((c) => <span class="kb-chip">{c}</span>)}</span>
              <span class="kb-svc-more">Ver detalle →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="kb-section kb-section--soft" aria-label="Soluciones por necesidad">
      <div class="kb-container">
        <h2 class="kb-solutions-title">¿Qué problema quieres resolver?</h2>
        <ul class="kb-solutions">
          {landings.map((l) => (
            <li><a href={`/${l.slug}`}>{l.label}</a></li>
          ))}
          <li><a href="/software-a-medida-sincelejo">Software a medida en Sincelejo</a></li>
        </ul>
      </div>
    </section>

    <div class="kb-marquee kb-marquee--soft">
      <div class="kb-marquee-track" data-marquee-track>
        <div class="kb-marquee-group kb-marquee-group--chips">
          {stack.map((t) => <span class="kb-chip">{t}</span>)}
        </div>
      </div>
    </div>

    <section id="pass" class="kb-section kb-pass">
      <div class="kb-pass-banner" data-parallax>
        <img src="/world/stop-3.webp" srcset="/world/stop-3-m.webp 960w, /world/stop-3.webp 1920w" sizes="100vw" width="1920" height="1080" alt="" loading="lazy" decoding="async" />
        <div class="kb-container kb-pass-banner-copy">
          <h2>Ecosistema PASS</h2>
          <p class="kb-body">Productos verticales publicados con su estado real, sin prometer madurez que todavía no existe.</p>
        </div>
      </div>
      <div class="kb-container">
        <div class="kb-grid kb-pass-grid" data-reveal-stagger>
          {passProducts.map((p) => (
            <div class="kb-pass-card">
              <div class="kb-pass-card-top">
                <span class="kb-pass-name">{p.name}</span>
                <span class="kb-dot-accent" aria-hidden="true"></span>
              </div>
              <p>{p.desc}</p>
              <div class="kb-chips">
                {p.tags.map((tg) => <span class="kb-chip">{tg}</span>)}
              </div>
              <span class="kb-pass-estado">{p.estado}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="proyectos" class="kb-section kb-projects">
      <div class="kb-container">
        <div class="kb-section-head">
          <h2>Proyectos destacados</h2>
          <a href="/portafolio" class="kb-more-link">Ver portafolio completo →</a>
        </div>
        <div class="kb-stack" data-stack>
          {projects.map((pr, i) => (
            <a href="#contacto" class="kb-stack-card" data-stack-card style={`--i:${i}`}>
              <div class="kb-stack-info">
                <span class="kb-mono kb-stack-n">{String(i + 1).padStart(2, "0")} / {String(projects.length).padStart(2, "0")}</span>
                <span class="kb-mono kb-text-soft">{pr.sector}</span>
                <h3>{pr.name}</h3>
                <p>{pr.desc}</p>
                <div class="kb-chips">
                  {pr.tags.map((tg) => <span class="kb-chip">{tg}</span>)}
                </div>
                <span class="kb-stack-estado">{pr.estado}</span>
              </div>
              <div class="kb-stack-media">
                {pr.image ? (
                  <img src={pr.image} alt={pr.name} width="2400" height="1350" loading="lazy" decoding="async" />
                ) : (
                  <div class="kb-proj-fallback"><span>{initials(pr.name)}</span></div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="clientes" class="kb-section kb-section--soft">
      <div class="kb-container">
        <div class="kb-section-head">
          <div>
            <span class="kb-eyebrow">Prueba, no promesa</span>
            <h2>Sitios reales, en producción</h2>
          </div>
          <p class="kb-body">Captura tomada en vivo de cada sitio. El enlace lleva directo a producción, no a una demo.</p>
        </div>
        <div class="kb-client-bento" data-reveal-stagger>
          {clientSites.map((c) => (
            <a href={c.url} target="_blank" rel="noopener" class="kb-client-card">
              <div class="kb-client-frame">
                <div class="kb-client-chrome" aria-hidden="true">
                  <span class="kb-client-dot"></span><span class="kb-client-dot"></span><span class="kb-client-dot"></span>
                  <span class="kb-client-url-bar">{c.url.replace("https://", "")}</span>
                </div>
                <img
                  src={c.image}
                  srcset={`${c.image.replace(".webp", "-480.webp")} 480w, ${c.image} 960w`}
                  sizes="(max-width: 640px) calc(100vw - 36px), (max-width: 1180px) 50vw, 600px"
                  width="960" height="600"
                  alt={`Captura en vivo de ${c.name}`}
                  loading="lazy"
                />
              </div>
              <div class="kb-client-body">
                <span class="kb-client-name">{c.name} ↗</span>
                <p>{c.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="proceso" class="kb-section">
      <div class="kb-container kb-proceso-grid">
        <div class="kb-proceso-sticky">
          <h2>Del diagnóstico<br />a producción</h2>
          <p class="kb-body">Cuatro etapas con entregables claros y trazabilidad en cada paso.</p>
        </div>
        <ol class="kb-proceso-list" data-progress>
          <span class="kb-proceso-line" aria-hidden="true"><i></i></span>
          {pasos.map((st) => (
            <li class="kb-proceso-row" data-progress-step>
              <span class="kb-proceso-n" aria-hidden="true">{st.n}</span>
              <div>
                <h3><span class="sr-only">Paso {st.n}: </span>{st.title}</h3>
                <p>{st.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="kb-section kb-facts" data-parallax aria-label="KOR Bytes en números">
      <img src="/world/stop-2.webp" srcset="/world/stop-2-m.webp 960w, /world/stop-2.webp 1920w" sizes="100vw" width="1920" height="1080" alt="" loading="lazy" decoding="async" />
      <div class="kb-container kb-facts-inner">
        <h2>KOR Bytes en números</h2>
        <div class="kb-hechos-grid" data-reveal-stagger>
          {hechos.map((h) => (
            <div class="kb-hecho">
              <div class="kb-hecho-k" data-count={/^\d+$/.test(h.k) ? h.k : undefined}>{h.k}</div>
              <div class="kb-hecho-v">{h.v}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="fundador" class="kb-section kb-founder">
      <div class="kb-container">
        <span class="kb-eyebrow">Quién construye esto</span>
        <p class="kb-founder-quote" data-words>Quien responde y firma cada entrega soy yo.</p>
        <div class="kb-founder-grid">
          <div>
            <h2>{FOUNDER_NAME}</h2>
            <p class="kb-founder-role kb-mono">{FOUNDER_TITLE}</p>
          </div>
          <div class="kb-founder-copy">
            <p class="kb-lead">Más de 10 años en Laravel y 5+ en React, diseñando APIs, integraciones y arquitecturas para operaciones reales.</p>
            <p>Por ahora el equipo de KOR Bytes soy yo, apoyado en el camino por agentes de IA para moverme más rápido en diagnóstico, código y despliegue. Prefiero decirlo así de claro a inflar el tamaño del estudio.</p>
            <div class="kb-founder-links">
              <a href={GITHUB_FOUNDER_URL} target="_blank" rel="noopener">GitHub · korozcolt</a>
              <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="preguntas" class="kb-section">
      <div class="kb-container kb-faq-grid">
        <div class="kb-faq-sticky">
          <h2>Software para<br />operaciones reales.</h2>
          <p class="kb-body">Respuestas directas para empresas de Sincelejo, Sucre, Colombia y LATAM que están evaluando un proyecto digital.</p>
        </div>
        <div class="kb-faq-list">
          {faqs.map((faq) => (
            <details class="kb-faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contacto" class="kb-section kb-section--soft">
      <div class="kb-container">
        <div class="kb-cta">
          <div>
            <span class="kb-eyebrow">Siguiente paso</span>
            <h2>¿Qué proceso<br />quieres <span class="kb-accent-text">ordenar</span> primero?</h2>
            <p class="kb-lead">Podemos partir desde un producto nuevo, una integración, un rediseño web, una automatización o una plataforma existente que necesita estructura.</p>
            <p class="kb-cta-finder">
              Encuéntranos también en
              <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a> y desde
              <span class="kb-text">Sincelejo, Sucre, Colombia.</span>
            </p>
          </div>
          <div class="kb-cta-actions">
            <a class="kb-cta-btn kb-cta-btn--primary" href={whatsapp("Hola KOR Bytes, quiero empezar un proyecto.")} target="_blank" rel="noopener">Escribir por WhatsApp<span>→</span></a>
            <a class="kb-cta-btn" href={`mailto:${EMAIL}`}>{EMAIL}<span>→</span></a>
            <a class="kb-cta-btn" href="tel:+573043978157">+57 304 397 8157<span>→</span></a>
          </div>
        </div>
      </div>
    </section>
    </div>
  </main>

  <Footer />
  <WhatsAppFab message="Hola KOR Bytes, quiero un diagnóstico para mi proyecto de software o producto digital." />

  <script>
    const preloader = document.getElementById("preloader");
    const numEl = document.getElementById("preloader-num");
    const fillEl = document.getElementById("preloader-fill");
    const header = document.getElementById("site-header");

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    function dismissPreloader() {
      if (!preloader || preloader.dataset.done) return;
      preloader.dataset.done = "1";
      preloader.style.pointerEvents = "none";
      preloader.style.opacity = "0";
      setTimeout(() => { preloader.style.visibility = "hidden"; }, 600);
    }

    if (reduced || !preloader) {
      dismissPreloader();
    } else {
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / 1400);
        if (numEl) numEl.textContent = String(Math.round(p * 100));
        if (fillEl) fillEl.style.width = p * 100 + "%";
        if (p < 1) requestAnimationFrame(tick);
        else dismissPreloader();
      };
      requestAnimationFrame(tick);
      setTimeout(dismissPreloader, 2400);
    }

    if (header) {
      addEventListener("scroll", () => {
        header.classList.toggle("is-scrolled", window.scrollY > 8);
      }, { passive: true });
    }

    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener("click", () => {
        const isOpen = mobileMenu.classList.toggle("is-open");
        menuBtn.setAttribute("aria-expanded", String(isOpen));
      });
      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.remove("is-open");
          menuBtn.setAttribute("aria-expanded", "false");
        });
      });
    }
  </script>
</BaseLayout>

<style>
  .kb-accent-text { color: var(--kb-accent); }
  .kb-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--kb-text-soft);
    margin-bottom: 1.1rem;
  }
  .kb-eyebrow--dot::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--kb-accent);
    animation: kb-pulse 2.6s ease-in-out infinite;
  }
  @keyframes kb-pulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }

  /* ── Preloader ─────────────────────────────────────────────── */
  .kb-preloader {
    position: fixed; inset: 0; z-index: 300;
    background: var(--kb-bg);
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 48px;
    transition: opacity 0.55s ease;
  }
  .kb-preloader-top { display: flex; align-items: center; gap: 12px; }
  .kb-preloader-mid { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; }
  .kb-preloader-label { font-family: "Familjen Grotesk", sans-serif; font-size: clamp(28px, 4vw, 64px); color: var(--kb-text-soft); }
  .kb-preloader-num { font-family: "Familjen Grotesk", sans-serif; font-size: clamp(56px, 10vw, 160px); line-height: 0.9; color: var(--kb-text-strong); }
  .kb-preloader-bar { height: 2px; background: rgba(255,255,255,0.1); margin-top: 26px; }
  .kb-preloader-fill { height: 2px; background: var(--kb-accent); width: 0%; }

  /* ── Logo ──────────────────────────────────────────────────── */
  .kb-mark {
    width: 34px; height: 34px; border-radius: 10px;
    background: var(--kb-accent);
    display: inline-flex; align-items: center; justify-content: center;
    font-family: "Familjen Grotesk", sans-serif; font-weight: 700;
    color: var(--kb-bg); font-size: 16px; flex-shrink: 0;
  }
  .kb-wordmark { display: block; height: 24px; line-height: 24px; font-family: "Familjen Grotesk", sans-serif; font-weight: 600; font-size: 18px; letter-spacing: -0.02em; color: var(--kb-text); white-space: nowrap; }
  .kb-wordmark--accent { color: var(--kb-accent); }
  .kb-dot { color: var(--kb-accent); }
  .kb-dot--inverse { color: var(--kb-text); }
  .kb-logo-slide-wrap { display: block; height: 24px; overflow: hidden; }
  .kb-logo-slide { display: block; transition: transform 0.55s cubic-bezier(0.6, 0, 0.2, 1); }
  a:hover .kb-logo-slide { transform: translateY(-100%); }

  .kb-logo-slot {
    display: flex; align-items: center; gap: 12px;
  }

  /* ── Header ────────────────────────────────────────────────── */
  .kb-header {
    position: fixed; top: 14px; left: 50%; z-index: 90;
    width: min(1120px, calc(100% - 28px));
    transform: translateX(-50%);
    background: rgba(5, 9, 15, 0.55);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--kb-radius-full);
    transition: background var(--kb-duration-normal) var(--kb-ease-out), border-color var(--kb-duration-normal) var(--kb-ease-out);
  }
  .kb-header.is-scrolled { background: rgba(5, 9, 15, 0.82); border-color: var(--kb-line-strong); }
  .kb-header-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding: 10px 12px 10px 18px;
  }
  .kb-hnav {
    display: flex; align-items: center; gap: 22px;
    font-size: 14px; color: var(--kb-text-muted);
  }
  .kb-hnav a:first-child { color: var(--kb-text); }
  .kb-hnav-cta {
    display: flex; align-items: center; gap: 10px;
    padding: 11px 20px; border-radius: var(--kb-radius-full);
    border: 1px solid var(--kb-line-strong); font-size: 13px;
    white-space: nowrap;
    transition: background var(--kb-duration-fast), border-color var(--kb-duration-fast), color var(--kb-duration-fast);
  }
  .kb-hnav-cta:hover { background: var(--kb-accent); border-color: var(--kb-accent); color: var(--kb-bg); }
  .kb-hnav-dot { width: 7px; height: 7px; border-radius: 99px; background: var(--kb-accent); display: inline-block; }

  .kb-menu-btn {
    display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px;
    width: 44px; height: 44px; padding: 0;
    border: 1px solid var(--kb-line-strong); background: transparent;
    border-radius: var(--kb-radius-full); color: var(--kb-text);
  }
  .kb-menu-btn span { display: block; width: 18px; height: 2px; margin: 0; background: currentColor; border-radius: 2px; }
  .kb-mobile-menu {
    display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0;
    padding: 10px; border-radius: var(--kb-radius-lg);
    background: rgba(5, 9, 15, 0.94);
    -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    border: 1px solid var(--kb-line-strong);
  }
  .kb-mobile-menu.is-open { display: grid; gap: 2px; }
