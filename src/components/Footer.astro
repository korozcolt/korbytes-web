---
import { whatsapp, EMAIL, GITHUB_URL, INSTAGRAM_URL } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="kb-foot" id="contacto-footer">
  <div class="kb-container">
    <div class="kb-foot-grid">
      <div class="kb-foot-brand-block">
        <a class="kb-foot-logo" href="#top" aria-label="KOR Bytes inicio">KOR Bytes<span class="kb-dot">.</span></a>
        <p class="kb-foot-pitch">
          Software operativo, productos verticales PASS, integraciones, automatizaciones, web e infraestructura digital desde Sincelejo para Colombia y LATAM.
        </p>
        <address class="kb-foot-address">
          <div><strong>Sincelejo</strong> · Sucre · Colombia</div>
          <div class="kb-foot-mute">Remoto · Modelo B2B</div>
        </address>
      </div>

      <div>
        <p class="kb-foot-heading">Empresa</p>
        <ul>
          <li><a href="#top">Inicio</a></li>
          <li><a href="#pass">Ecosistema PASS</a></li>
          <li><a href="#proyectos">Proyectos</a></li>
          <li><a href="/portafolio">Portafolio completo</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="/software-a-medida-sincelejo">Software a medida en Sincelejo</a></li>
          <li><a href="/programador-en-sincelejo">Programador en Sincelejo</a></li>
        </ul>
      </div>

      <div>
        <p class="kb-foot-heading">Encuéntranos</p>
        <ul>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          <li>
            <a href={whatsapp("Hola KOR Bytes, quiero una consultoría.")} target="_blank" rel="noopener">
              WhatsApp directo
            </a>
          </li>
          <li class="kb-foot-mono">+57 304 397 8157</li>
          <li><a href={GITHUB_URL} target="_blank" rel="noopener">GitHub · korozcolt</a></li>
          <li><a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram · @kor_bytes</a></li>
        </ul>
        <div class="kb-foot-cta">
          <a class="kb-btn kb-foot-btn" href={whatsapp("Hola KOR Bytes, quiero empezar un proyecto.")} target="_blank" rel="noopener">
            Empezar un proyecto
          </a>
        </div>
      </div>
    </div>

    <div class="kb-foot-foot">
      <div>© {year} KOR Bytes S.A.S. · Todos los derechos reservados · <a href="/aviso-legal" class="kb-foot-legal">Aviso legal</a></div>
      <div class="kb-foot-claim">Información publicada según estado de madurez, sin métricas no verificadas.</div>
      <a href="#top" class="kb-foot-top">Volver arriba ↑</a>
    </div>
  </div>
</footer>

<style>
  .kb-foot-logo {
    display: inline-flex;
    align-items: baseline;
    font-family: "Familjen Grotesk", sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--kb-text-strong);
    margin-bottom: 1.25rem;
  }
  .kb-dot { color: var(--kb-accent); }
  .kb-foot-pitch {
    color: var(--kb-text-muted);
    line-height: 1.62;
    font-size: 0.94rem;
    margin: 0 0 1.1rem;
    max-width: 360px;
  }
  .kb-foot-address {
    font-style: normal;
    color: var(--kb-text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .kb-foot-mute { color: var(--kb-text-soft); font-size: 0.8rem; }
  .kb-foot-mono {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    color: var(--kb-text-soft);
    letter-spacing: 0.02em;
  }
  .kb-foot-cta { margin-top: 1.1rem; }
  .kb-foot-btn { font-size: 0.86rem; padding: 0.7rem 1rem; }
  .kb-foot-top { color: var(--kb-text-muted); font-size: 0.82rem; }
  .kb-foot-legal { color: inherit; text-decoration: underline; }
</style>
