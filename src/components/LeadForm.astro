---
import { WHATSAPP_NUMBER, EMAIL } from "@/data/site";
import { needOptions } from "@/data/landings";

interface Props {
  need?: string;
  source: string;
}

const { need = needOptions[0], source } = Astro.props;
---

<form class="lead-form" data-lead-form data-wa={WHATSAPP_NUMBER} data-source={source} novalidate>
  <div class="lead-form__row">
    <label>
      <span>Tu nombre</span>
      <input name="nombre" type="text" autocomplete="name" required placeholder="Ej: Laura Pérez" />
    </label>
    <label>
      <span>Empresa <em>(opcional)</em></span>
      <input name="empresa" type="text" autocomplete="organization" placeholder="Ej: Droguería San José" />
    </label>
  </div>
  <label>
    <span>¿Qué necesitas?</span>
    <select name="necesidad">
      {needOptions.map((o) => <option value={o} selected={o === need}>{o}</option>)}
    </select>
  </label>
  <label>
    <span>Cuéntanos en una frase el problema <em>(opcional)</em></span>
    <textarea name="detalle" rows="3" placeholder="Ej: Llevamos el inventario en Excel y nunca cuadra con la tienda."></textarea>
  </label>
  <button class="kb-btn lead-form__submit" type="submit">Enviar por WhatsApp</button>
  <p class="lead-form__note">
    Se abre WhatsApp con tu mensaje listo para enviar. Respondemos en horario laboral. También puedes escribir a
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
  </p>
</form>

<script>
  declare function gtag(...args: unknown[]): void;

  document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const nombre = String(data.get("nombre") ?? "").trim();
      if (!nombre) {
        const field = form.querySelector<HTMLInputElement>('input[name="nombre"]');
        field?.focus();
        field?.setAttribute("aria-invalid", "true");
        return;
      }
      const empresa = String(data.get("empresa") ?? "").trim();
      const necesidad = String(data.get("necesidad") ?? "").trim();
      const detalle = String(data.get("detalle") ?? "").trim();

      const lines = [
        `Hola KOR Bytes, soy ${nombre}${empresa ? ` de ${empresa}` : ""}.`,
        `Necesito: ${necesidad}.`,
        detalle ? `Contexto: ${detalle}` : "",
        `(Escribo desde ${location.pathname})`,
      ].filter(Boolean);

      try {
        gtag("event", "generate_lead", {
          method: "form_whatsapp",
          lead_source: form.dataset.source ?? location.pathname,
          lead_need: necesidad,
          transport_type: "beacon",
        });
      } catch {}

      const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join("\n"))}`;
      window.open(url, "_blank", "noopener");
    });
  });
</script>

<style>
  .lead-form { display: grid; gap: 1rem; }
  .lead-form__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .lead-form label { min-width: 0; }
  .lead-form label { display: grid; gap: .45rem; font-size: .86rem; color: var(--kb-text-muted); }
  .lead-form label span { font-weight: 500; color: var(--kb-text); }
  .lead-form label em { font-style: normal; color: var(--kb-text-soft); font-weight: 400; }
  .lead-form input, .lead-form select, .lead-form textarea {
    width: 100%; font: inherit; font-size: 1rem; color: var(--kb-text-strong);
    background: var(--kb-bg); border: 1px solid var(--kb-line-strong);
    border-radius: var(--kb-radius-sm); padding: .8rem .9rem;
  }
  .lead-form textarea { resize: vertical; min-height: 84px; }
  .lead-form input:focus-visible, .lead-form select:focus-visible, .lead-form textarea:focus-visible {
    outline: 2px solid var(--kb-accent); outline-offset: 1px; border-color: var(--kb-accent);
  }
  .lead-form input[aria-invalid="true"] { border-color: #ff6b6b; }
  .lead-form__submit { justify-self: start; border: 0; cursor: pointer; font: inherit; font-weight: 600; }
  .lead-form__note { margin: 0; font-size: .8rem; color: var(--kb-text-soft); line-height: 1.55; }
  .lead-form__note a { color: var(--kb-accent); }
  @media (max-width: 560px) {
    .lead-form__row { grid-template-columns: 1fr; }
    .lead-form__submit { justify-self: stretch; }
  }
</style>
