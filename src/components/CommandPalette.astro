---
/**
 * Paleta de navegación (Ctrl/Cmd + K, o "/"). Es el toque propio del menú: en vez de
 * esconder todo detrás de una hamburguesa, el visitante puede escribir y saltar a
 * cualquier sección, servicio o guía. Las entradas salen de los datos del sitio
 * (landings, guías), nunca se teclean aparte.
 *
 * Accesibilidad: <dialog> modal nativo (foco atrapado, Esc cierra), patrón combobox +
 * listbox con aria-activedescendant, navegación completa con teclado.
 */
import { landings } from "@/data/landings";
import { guides } from "@/data/guides";
import { whatsapp, EMAIL, GITHUB_URL } from "@/data/site";

interface Item {
  group: string;
  label: string;
  hint: string;
  href: string;
  external?: boolean;
}

const secciones: Item[] = [
  { label: "Inicio y recorrido", href: "#top" },
  { label: "Ecosistema PASS", href: "#pass" },
  { label: "Servicios", href: "#servicios" },
  { label: "Proyectos destacados", href: "#proyectos" },
  { label: "Sitios reales en producción", href: "#clientes" },
  { label: "Cómo trabajamos", href: "#proceso" },
  { label: "Quién construye esto", href: "#fundador" },
  { label: "Preguntas frecuentes", href: "#preguntas" },
  { label: "Contacto", href: "#contacto" },
].map((s) => ({ ...s, group: "Secciones", hint: s.href }));

const soluciones: Item[] = [
  ...landings.map((l) => ({ group: "Soluciones", label: l.label, hint: `/${l.slug}`, href: `/${l.slug}` })),
  { group: "Soluciones", label: "Software a medida en Sincelejo", hint: "/software-a-medida-sincelejo", href: "/software-a-medida-sincelejo" },
  { group: "Soluciones", label: "Portafolio completo", hint: "/portafolio", href: "/portafolio" },
];

const guias: Item[] = [
  { group: "Guías", label: "Todas las guías", hint: "/guias", href: "/guias" },
  ...guides.map((g) => ({
    group: "Guías",
    label: g.title.split(" | ")[0],
    hint: `/guias/${g.slug}`,
    href: `/guias/${g.slug}`,
  })),
];

const acciones: Item[] = [
  { group: "Contacto", label: "Escribir por WhatsApp", hint: "wa.me", href: whatsapp("Hola KOR Bytes, quiero una consultoría para mi proyecto digital."), external: true },
  { group: "Contacto", label: `Enviar un correo`, hint: EMAIL, href: `mailto:${EMAIL}` },
  { group: "Contacto", label: "GitHub de KOR Bytes", hint: "github.com", href: GITHUB_URL, external: true },
];

const all = [...secciones, ...soluciones, ...guias, ...acciones];
const groups = Array.from(new Set(all.map((i) => i.group)));
let n = 0;
---

<dialog class="kb-pal" id="command-palette" aria-label="Buscar y navegar por el sitio">
  <div class="kb-pal-box">
    <div class="kb-pal-head">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input
        id="pal-input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="pal-list"
        aria-autocomplete="list"
        aria-label="Buscar secciones, soluciones y guías"
        placeholder="Buscar secciones, soluciones, guías…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <kbd>Esc</kbd>
    </div>

    <ul class="kb-pal-list" id="pal-list" role="listbox" aria-label="Resultados">
      {
        groups.map((g) => (
          <>
            <li role="presentation" class="kb-pal-group" data-group={g}>{g}</li>
            {all
              .filter((i) => i.group === g)
              .map((i) => {
                const id = `pal-opt-${n++}`;
                return (
                  <li
                    role="option"
                    id={id}
                    aria-selected="false"
                    class="kb-pal-opt"
                    data-href={i.href}
                    data-external={i.external ? "1" : undefined}
                    data-group={g}
                    data-text={`${i.label} ${i.hint} ${g}`}
                  >
                    <span class="kb-pal-label">{i.label}</span>
                    <span class="kb-pal-hint">{i.hint}</span>
                  </li>
                );
              })}
          </>
        ))
      }
    </ul>
    <p class="kb-pal-empty" id="pal-empty" hidden>No encontramos eso. Prueba con "pass", "precio" o "whatsapp".</p>

    <div class="kb-pal-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> moverse</span>
      <span><kbd>↵</kbd> abrir</span>
      <span class="kb-pal-foot-r"><kbd data-kbd-mod>Ctrl</kbd><kbd>K</kbd> en cualquier momento</span>
    </div>
  </div>
</dialog>

<script>
  const dlg = document.getElementById("command-palette") as HTMLDialogElement | null;
  const input = document.getElementById("pal-input") as HTMLInputElement | null;
  const list = document.getElementById("pal-list");
  const empty = document.getElementById("pal-empty");

  if (dlg && input && list && empty) {
    const opts = Array.from(list.querySelectorAll<HTMLElement>(".kb-pal-opt"));
    const groupEls = Array.from(list.querySelectorAll<HTMLElement>(".kb-pal-group"));
    const norm = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
    const haystack = new Map(opts.map((o) => [o, norm(o.dataset.text ?? "")]));
    let active = -1;
    let lastFocus: Element | null = null;

    const visible = () => opts.filter((o) => !o.hidden);

    function setActive(i: number) {
      const v = visible();
      if (!v.length) {
        active = -1;
        input!.removeAttribute("aria-activedescendant");
        return;
      }
      active = (i + v.length) % v.length;
      opts.forEach((o) => {
        o.classList.remove("is-active");
        o.setAttribute("aria-selected", "false");
      });
      const el = v[active];
      el.classList.add("is-active");
      el.setAttribute("aria-selected", "true");
      input!.setAttribute("aria-activedescendant", el.id);
      el.scrollIntoView({ block: "nearest" });
    }

    function filter(q: string) {
      const tokens = norm(q).split(/\s+/).filter(Boolean);
      opts.forEach((o) => {
        const h = haystack.get(o) ?? "";
        o.hidden = !tokens.every((t) => h.includes(t));
      });
      groupEls.forEach((g) => {
        g.hidden = !opts.some((o) => o.dataset.group === g.dataset.group && !o.hidden);
      });
      empty!.hidden = visible().length > 0;
      setActive(0);
    }

    function open() {
      if (dlg!.open) return;
      lastFocus = document.activeElement;
      input!.value = "";
      filter("");
      dlg!.showModal();
      input!.focus();
    }
    function close() {
      dlg!.close();
      if (lastFocus instanceof HTMLElement) lastFocus.focus({ preventScroll: true });
    }

    function go(el: HTMLElement | undefined) {
      if (!el) return;
      const href = el.dataset.href ?? "";
      close();
      if (el.dataset.external) window.open(href, "_blank", "noopener");
      else if (href.startsWith("#")) {
        const target = href === "#top" ? null : document.querySelector(href);
        if (target) target.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        else window.scrollTo({ top: 0, behavior: "smooth" });
        history.replaceState(null, "", href);
      } else window.location.href = href;
    }

    input.addEventListener("input", () => filter(input.value));
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
      else if (e.key === "Home") { e.preventDefault(); setActive(0); }
      else if (e.key === "End") { e.preventDefault(); setActive(visible().length - 1); }
      else if (e.key === "Enter") { e.preventDefault(); go(visible()[active]); }
    });
    list.addEventListener("click", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>(".kb-pal-opt");
      if (el) go(el);
    });
    list.addEventListener("pointermove", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>(".kb-pal-opt");
      const i = el ? visible().indexOf(el) : -1;
      if (i >= 0 && i !== active) setActive(i);
    });
    // Clic fuera de la caja (sobre el fondo del diálogo) cierra.
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) close();
    });

    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement | null;
      const typing = !!t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable);
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        dlg.open ? close() : open();
      } else if (e.key === "/" && !typing && !dlg.open) {
        e.preventDefault();
        open();
      }
    });
    document.querySelectorAll("[data-palette-open]").forEach((b) => b.addEventListener("click", open));

    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    document.querySelectorAll("[data-kbd-mod]").forEach((k) => (k.textContent = isMac ? "⌘" : "Ctrl"));
  }
</script>

<style>
  .kb-pal {
    width: min(660px, calc(100vw - 24px));
    max-height: min(560px, calc(100dvh - 24px));
    margin: 12vh auto auto;
    padding: 0;
    color: var(--kb-text);
    background: var(--kb-bg-raised);
    border: 1px solid var(--kb-line-strong);
    border-radius: 14px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  .kb-pal::backdrop {
    background: rgba(2, 6, 14, 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .kb-pal[open] {
    animation: kb-pal-in 180ms var(--kb-ease-out);
  }
  @keyframes kb-pal-in {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  .kb-pal-box { display: flex; flex-direction: column; max-height: inherit; }
  .kb-pal-head {
    display: flex; align-items: center; gap: 12px;
    padding: 0 16px; height: 58px; flex-shrink: 0;
    border-bottom: 1px solid var(--kb-line);
    color: var(--kb-text-soft);
  }
  .kb-pal-head input {
    flex: 1; min-width: 0; height: 100%;
    background: transparent; border: 0; outline: 0;
    color: var(--kb-text-strong);
    font: 500 1.05rem "Inter Tight", system-ui, sans-serif;
  }
  .kb-pal-head input::placeholder { color: var(--kb-text-soft); }
  .kb-pal-head:focus-within { color: var(--kb-accent); box-shadow: inset 0 -2px 0 var(--kb-accent); }
  .kb-pal-list {
    list-style: none; margin: 0; padding: 8px;
    overflow-y: auto; overscroll-behavior: contain;
  }
  .kb-pal-group {
    padding: 14px 10px 6px;
    font: 500 0.68rem "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--kb-text-soft);
  }
  .kb-pal-opt {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    min-height: 44px; padding: 8px 10px; border-radius: 8px;
    cursor: pointer; color: var(--kb-text);
  }
  /* `display` de autor pisa el atributo hidden: se restablece para que el filtro oculte de verdad. */
  .kb-pal-opt[hidden], .kb-pal-group[hidden] { display: none; }
  .kb-pal-opt.is-active { background: rgba(var(--kb-accent-rgb), 0.14); color: var(--kb-text-strong); }
  .kb-pal-opt.is-active .kb-pal-hint { color: var(--kb-accent); }
  .kb-pal-label { font-size: 0.95rem; line-height: 1.3; }
  .kb-pal-hint {
    flex-shrink: 0; max-width: 40%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font: 400 0.72rem "JetBrains Mono", ui-monospace, monospace; color: var(--kb-text-soft);
  }
  .kb-pal-empty { margin: 0; padding: 28px 20px 32px; text-align: center; color: var(--kb-text-muted); font-size: 0.92rem; }
  .kb-pal-foot {
    display: flex; gap: 18px; align-items: center; flex-shrink: 0;
    padding: 10px 16px; border-top: 1px solid var(--kb-line);
    font-size: 0.72rem; color: var(--kb-text-soft);
  }
  .kb-pal-foot-r { margin-left: auto; }
  kbd {
    display: inline-block; min-width: 20px; margin-right: 4px; padding: 2px 6px;
    text-align: center; border: 1px solid var(--kb-line-strong); border-radius: 5px;
    background: rgba(255, 255, 255, 0.04);
    font: 500 0.68rem "JetBrains Mono", ui-monospace, monospace; color: var(--kb-text-muted);
  }
  @media (max-width: 640px) {
    .kb-pal { margin-top: 8vh; }
    .kb-pal-hint { display: none; }
    .kb-pal-foot { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kb-pal[open] { animation: none; }
  }
</style>
