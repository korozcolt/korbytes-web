---
import "@/styles/global.css";
import "@phosphor-icons/web/regular";
import { SITE, page, structuredData } from "@/data/site";

const canonical = new URL("/", SITE).toString();
const schema = JSON.stringify(structuredData(canonical));
---

<!doctype html>
<html class="dark" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="author" content="KOR Bytes S.A.S." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={`${SITE}/images/logo-oficial.png`} />
    <meta property="og:image:alt" content="KOR Bytes S.A.S. software operativo y productos PASS" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={`${SITE}/images/logo-oficial.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#05090f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Font load: preconnect enlaza el origen; el CSS se aplica asíncrono vía media swap,
         de modo que no bloquea el primer paint mientras LCP entra en ~1.8s. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      media="print"
      data-fonts="swap"
    />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" /></noscript>
    <!-- GA4: config queued immediately, library deferred to after load to avoid long main-thread task -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-FGEEJ8RSN0");
      window.addEventListener("load", function () {
        var s = document.createElement("script");
        s.src = "https://www.googletagmanager.com/gtag/js?id=G-FGEEJ8RSN0";
        s.async = true;
        document.head.appendChild(s);
        // Promote preloaded fonts from `media=print` to `media=all`.
        document.querySelectorAll('link[data-fonts="swap"]').forEach(function (l) {
          l.removeAttribute("data-fonts");
          l.media = "all";
        });
      }, { once: true });
    </script>
    <script is:inline type="application/ld+json" set:html={schema}></script>
  </head>
  <body>
    <slot />
    <script>
      import "@/scripts/animate";
    </script>
  </body>
</html>
