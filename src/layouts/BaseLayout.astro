---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { SITE, page, structuredData, type BreadcrumbItem } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  faqs?: Array<{ question: string; answer: string }>;
  breadcrumb?: BreadcrumbItem[];
  extraGraph?: Array<Record<string, unknown>>;
}

const {
  title = page.title,
  description = page.description,
  path = "/",
  faqs,
  breadcrumb,
  extraGraph,
} = Astro.props;
const canonical = new URL(path, SITE).toString();
// Imagen para compartir (1200x630). Fuente editable: scripts/og-image.html.
const ogImage = `${SITE}/images/og-default.jpg`;
const schema = JSON.stringify(
  structuredData(canonical, { title, description, faqs, breadcrumb, extraGraph })
);
---

<!doctype html>
<html class="dark" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="KOR Bytes S.A.S." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="De caos a flujo a sistema: No hacemos software. Ordenamos operaciones. KOR Bytes, software operativo y productos PASS desde Sincelejo." />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- ?v=2: los navegadores cachean el favicon con terquedad; subir el número al cambiar los íconos. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#050d1a" />
    <!-- Fuentes autoalojadas por Astro (ver astro.config.mjs). Solo se precargan las críticas
         (titulares y texto); la mono se carga cuando se necesita. -->
    <Font cssVariable="--font-familjen" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
    <!-- GA4: config queued immediately, library deferred to after load to avoid long main-thread task -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-FGEEJ8RSN0");

      var gaLoaded = false;
      function loadGA4() {
        if (gaLoaded) return;
        gaLoaded = true;
        var s = document.createElement("script");
        s.src = "https://www.googletagmanager.com/gtag/js?id=G-FGEEJ8RSN0";
        s.async = true;
        document.head.appendChild(s);
      }

      document.addEventListener("click", function (event) {
        var source = event.target instanceof Element ? event.target.closest("a") : null;
        if (!source) return;

        var href = source.getAttribute("href") || "";
        var method = href.startsWith("https://wa.me/") ? "whatsapp"
          : href.startsWith("mailto:") ? "email"
          : href.startsWith("tel:") ? "phone"
          : null;

        if (method) {
          gtag("event", "generate_lead", {
            method: method,
            transport_type: "beacon"
          });
          loadGA4();
        }
      });
      window.addEventListener("load", function () {
        loadGA4();
      }, { once: true });
    </script>
    <script is:inline type="application/ld+json" set:html={schema}></script>
  </head>
  <body>
    <slot />
    <script>
      import "@/scripts/animate";
    </script>
  </body>
</html>
